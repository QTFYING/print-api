{
  "name": "pte-api",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "dev:server": "pnpm --filter @pte/server dev",
    "dev:worker": "pnpm --filter @pte/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "openapi:export": "pnpm --filter @pte/server openapi:export",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && pnpm db:indexes:ensure",
    "db:migrate:dev": "prisma migrate dev && pnpm db:indexes:ensure",
    "db:indexes:ensure": "prisma db execute --file prisma/sql/partial_unique_indexes.sql --schema prisma/schema.prisma",
    "db:reset:dev": "prisma db execute --file prisma/sql/dev_reset_schema.sql --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "tunnel": "bash scripts/dev/tunnel.sh myserver"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {},
  "dependencies": {
    "@prisma/client": "6.19.3",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0"
  }
}
