# ============================================================
# Nginx 占位（阶段1 出正式 conf 并纳入 301 表验收）：
#   /         -> portal (Next.js 15 SSR, 127.0.0.1:3000)
#   /api/v1/* -> server  (NestJS,       127.0.0.1:4000)
#   /pc/*     -> 桥① 反向代理老 Windows 服务器（切换前启用，员工/展商无感）
# TLS 终结 + HSTS + WAF 联动；301 表与 web 仓 route-map.csv 双保底。
# ============================================================
server {
  listen 443 ssl;
  http2 on;
  server_name printchina.com;

  # ssl_certificate     /etc/nginx/certs/printchina.com.pem;
  # ssl_certificate_key /etc/nginx/certs/printchina.com.key;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location /api/v1/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # 桥①：并行期反向代理老系统（启用前与甲方确认老服务器访问策略）
  # location /pc/ {
  #   proxy_pass https://<老服务器内网地址>/pc/;
  #   proxy_set_header Host $host;
  # }
}

server {
  listen 80;
  server_name printchina.com;
  return 301 https://$host$request_uri;
}
