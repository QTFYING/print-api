  DONGGUAN_ZHONGYIN // 1 东莞中印协
  BEIJING_HUAGANG // 2 北京华港
  CHINA_PRINTING // 3 中国印协
  GUANGDONG_PRINTING // 4 广东印协
}

enum ApprovalNodeStatus {
