  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([exhibitorId])
  @@index([nameCn])
  @@map("product_item")

  // —— PG 原生索引（Prisma 可表达部分，随迁移生成；部分唯一索引见 prisma/sql）——
  @@index([legacyExtra(ops: raw("jsonb_path_ops"))], type: Gin)
  @@index([nameCn(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_item_name_cn_trgm_gin")
}

/// 取代 expo_data_hkxx（会刊信息）
model YearbookInfo {
  id          String    @id @default(uuid(7))
  exhibitorId String    @unique @map("exhibitor_id")
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id])
