  exhibitorId   String       @map("exhibitor_id")
  exhibitor     Exhibitor    @relation(fields: [exhibitorId], references: [id])
  feeTemplateId String?      @map("fee_template_id")
  feeTemplate   FeeTemplate? @relation(fields: [feeTemplateId], references: [id])
  quantity      Int          @default(1)
  amount        Decimal?     @db.Decimal(12, 2)
  spec          String?
  remark        String?
  submitted     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([exhibitorId])
  @@map("billing_request")
}

/// 取代 expo_data_jlhd（交流活动）+ pte_event（门户活动，统一数据）
model EventActivity {
  id               String     @id @default(uuid(7))
  showId           String?    @map("show_id")
  show             Show?      @relation(fields: [showId], references: [id])
  exhibitorId      String?    @map("exhibitor_id")
  exhibitor        Exhibitor? @relation(fields: [exhibitorId], references: [id])
  nameCn           String?    @map("name_cn") /// HDMC / etitle
  nameEn           String?    @map("name_en")
  venue            String? /// HDDD / eplace
  startsAt         DateTime?  @map("starts_at") /// HDSJ / edate+etime
  endsAt           DateTime?  @map("ends_at")
  expectedVisitors Int?       @map("expected_visitors") /// CXRS
  content          String? /// HDNR
  source           String     @default("EXPO") /// EXPO=资料子库 / PORTAL=门户
  submitted        Boolean    @default(false)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([showId, startsAt])
  @@map("event_activity")
}

/// 取代 query_pagination(任意表名) 拖库通道（§6.4/§9 S2：白名单注册表）
model QueryRegistry {
  id                String   @id @default(uuid(7))
  code              String   @unique
  targetView        String   @map("target_view") /// 只允许登记过的只读视图
  allowedColumns    Json     @map("allowed_columns") @db.JsonB
  allowedPredicates Json?    @map("allowed_predicates") @db.JsonB
  publicApi         Boolean  @default(false) @map("public_api")
  rateLimitPerMin   Int      @default(60) @map("rate_limit_per_min")
  description       String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  apiKeys ApiKeyRegistry[]

  @@map("query_registry")
}

/// 对外 API 的 OAuth 式 Key（配 限流 + 吊销）
model ApiKey {
  id              String    @id @default(uuid(7))
  name            String
  keyHash         String    @unique @map("key_hash") /// 只存哈希，不存明文
  ownerType       String    @default("INTERNAL") @map("owner_type")
  rateLimitPerMin Int       @default(120) @map("rate_limit_per_min")
  revokedAt       DateTime? @map("revoked_at")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  registries ApiKeyRegistry[]

  @@map("api_key")
}

model ApiKeyRegistry {
  id         String        @id @default(uuid(7))
  apiKeyId   String        @map("api_key_id")
  apiKey     ApiKey        @relation(fields: [apiKeyId], references: [id])
  registryId String        @map("registry_id")
  registry   QueryRegistry @relation(fields: [registryId], references: [id])

  @@unique([apiKeyId, registryId])
  @@map("api_key_registry")
}

// ==================== 8. 会员域（新增，对标 MyChinaplas）====================

/// 一表三身份（观众/展商/员工）；旧 expo_admin + pte_user + expo_order_login + itma_pas 归并于此
model Member {
  id                 String            @id @default(uuid(7))
  displayName        String?           @map("display_name")
  mobile             String?           @unique
  email              String?           @unique
  passwordHash       String?           @map("password_hash")
  hashAlgorithm      PasswordAlgorithm @default(ARGON2ID) @map("hash_algorithm")
  mustChangePassword Boolean           @default(false) @map("must_change_password") /// 旧 MD5 迁移强制首登改密
  status             String            @default("ACTIVE") /// ACTIVE/LOCKED/CANCELLED
  failedLoginCount   Int               @default(0) @map("failed_login_count")
  lockedUntil        DateTime?         @map("locked_until")
  lastLoginAt        DateTime?         @map("last_login_at")
  legacyRef          String?           @map("legacy_ref") /// 旧账号来源（expo_admin.id / expo_exhibitors.015 …）
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  identities      MemberIdentity[]
  roles           MemberRole[]
  wechatBindings  WechatBinding[]
  favorites       Favorite[]
  footprints      Footprint[]
  namecards       Namecard[]
  eTickets        ETicket[]
  invoiceRequests InvoiceRequest[]
  stageLogsActor  ExhibitorStageLog[]   @relation("StageLogActor")
  contactLogs     ExhibitorContactLog[] @relation("ExhibitorContactAuthor")
  visitorContacts VisitorContactLog[]   @relation("VisitorContactAuthor")
  visitors        Visitor[]             @relation("VisitorMember")
  approvalNodes   ApprovalNode[]        @relation("ApprovalNodeAssignee")
  approvalHistory ApprovalHistory[]     @relation("ApprovalHistoryActor")
  lockBy          ReceivableLock[]      @relation("LockBy")
  lockUnlockedBy  ReceivableLock[]      @relation("LockUnlockedBy")
  auditLogs       AuditLog[]
  exportJobs      ExportJob[]
  dataScopes      DataScope[]
  staffProfile    StaffProfile?

  @@map("member")
}

model MemberIdentity {
  id          String     @id @default(uuid(7))
  memberId    String     @map("member_id")
  member      Member     @relation(fields: [memberId], references: [id])
  kind        MemberKind
  refId       String?    @map("ref_id") /// exhibitorId / 其它域主键
  exhibitorId String?    @map("exhibitor_id")
  exhibitor   Exhibitor? @relation(fields: [exhibitorId], references: [id])
  isPrimary   Boolean    @default(false) @map("is_primary")
  verifiedAt  DateTime?  @map("verified_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([memberId, kind, refId]) /// 部分唯一索引：WHERE ref_id IS NOT NULL
  @@index([kind, refId])
  @@map("member_identity")
}

model WechatBinding {
  id       String   @id @default(uuid(7))
  memberId String   @map("member_id")
  member   Member   @relation(fields: [memberId], references: [id])
  openid   String   @unique
  unionid  String?
  nickname String?
  boundAt  DateTime @default(now()) @map("bound_at")

  @@map("wechat_binding")
}

model Favorite {
  id         String   @id @default(uuid(7))
  memberId   String   @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id])
  targetType String   @map("target_type") /// EXHIBITOR/PRODUCT/EVENT/ARTICLE
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([memberId, targetType, targetId])
  @@map("favorite")
}

model Footprint {
  id         String   @id @default(uuid(7))
  memberId   String   @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id])
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  @@index([memberId, viewedAt])
  @@map("footprint")
}

model Namecard {
  id        String   @id @default(uuid(7))
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id])
  company   String?
  title     String?
  phone     String?
  email     String?
  wechatId  String?  @map("wechat_id")
  qrPayload String?  @map("qr_payload")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([memberId])
  @@map("namecard")
}

/// 电子参观证（sharp 预制模板合成，禁 headless Chrome；§4.1）
model ETicket {
  id             String               @id @default(uuid(7))
  serialNo       String               @unique @map("serial_no")
  showId         String?              @map("show_id")
  registrationId String?              @map("registration_id")
  registration   VisitorRegistration? @relation(fields: [registrationId], references: [id])
  memberId       String?              @map("member_id")
  member         Member?              @relation(fields: [memberId], references: [id])
  holderName     String?              @map("holder_name")
  holderMobile   String?              @map("holder_mobile") /// 展示脱敏
  qrPayload      String?              @map("qr_payload")
  status         ETicketStatus        @default(ISSUED)
  pdfObjectKey   String?              @map("pdf_object_key")
  issuedAt       DateTime             @default(now()) @map("issued_at")
  usedAt         DateTime?            @map("used_at")
  gate           String?

  @@index([showId, status])
  @@map("e_ticket")
}

/// 自助开票（打通财务域）
model InvoiceRequest {
  id          String         @id @default(uuid(7))
  memberId    String         @map("member_id")
  member      Member         @relation(fields: [memberId], references: [id])
  paymentId   String?        @map("payment_id")
  payment     PaymentRecord? @relation(fields: [paymentId], references: [id])
  title       String
  taxNo       String?        @map("tax_no")
  kind        InvoiceKind    @default(VAT_GENERAL)
  amount      Decimal        @db.Decimal(12, 2)
  email       String?
  phone       String?
  status      String         @default("SUBMITTED") /// SUBMITTED/APPROVED/ISSUED/REJECTED
  invoiceId   String?        @map("invoice_id")
  requestedAt DateTime       @default(now()) @map("requested_at")
  processedBy String?        @map("processed_by")
  processedAt DateTime?      @map("processed_at")
  note        String?

  @@index([memberId])
  @@map("invoice_request")
}

/// 验证码与三兜底通道（国际：短信/语音/扫码）；短时效与吊销在 Redis
model SmsVerifyLog {
  id            String     @id @default(uuid(7))
  mobile        String
  scene         SmsScene
  channel       SmsChannel @default(SMS)
  codeHash      String?    @map("code_hash")
  sentAt        DateTime   @default(now()) @map("sent_at")
  expiresAt     DateTime   @map("expires_at")
  verifiedAt    DateTime?  @map("verified_at")
  failCount     Int        @default(0) @map("fail_count")
  lockedUntil   DateTime?  @map("locked_until")
  ip            String?
  providerMsgId String?    @map("provider_msg_id")

  @@index([mobile, scene, sentAt])
  @@map("sms_verify_log")
}

// ==================== 平台基座：RBAC / 审计 / 内容 / 文件 / 任务 ====================

model Role {
  id          String  @id @default(uuid(7))
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  members     MemberRole[]

  @@map("role")
}

model Permission {
  id    String  @id @default(uuid(7))
  code  String  @unique /// financial.lock.toggle / contract.approve / export.pii …
  name  String
  group String?

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String     @id @default(uuid(7))
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model MemberRole {
  id        String   @id @default(uuid(7))
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id])
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  @@unique([memberId, roleId])
  @@map("member_role")
}

/// 取代 hall01~20 布尔列 + expo_partition_power：角色 × (届次×展馆) 两维授权（§9）
model DataScope {
  id       String    @id @default(uuid(7))
  memberId String?   @map("member_id")
  member   Member?   @relation(fields: [memberId], references: [id])
  roleId   String?   @map("role_id")
  hallId   String?   @map("hall_id")
  hall     ShowHall? @relation(fields: [hallId], references: [id])
  showId   String?   @map("show_id")
  level    String    @default("HALL") /// SHOW/HALL/PARTITION

  @@index([memberId])
  @@map("data_scope")
}

model StaffProfile {
  id         String   @id @default(uuid(7))
  memberId   String   @unique @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id])
  employeeNo String?  @map("employee_no")
  department String?
  position   String?
  active     Boolean  @default(true) /// 旧 state 软删
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("staff_profile")
}

/// 取代 expo_log；同时是切换日「数据回补预案」的重放来源（§8 铁规三）
model AuditLog {
  id          String          @id @default(uuid(7))
  actorId     String?         @map("actor_id")
  actor       Member?         @relation(fields: [actorId], references: [id])
  actorKind   String          @default("STAFF") @map("actor_kind") /// STAFF/EXHIBITOR/SYSTEM
  action      String /// CREATE/UPDATE/DELETE/LOGIN/EXPORT/LOCK/UNLOCK/APPROVE…
  targetKind  AuditTargetKind @map("target_kind")
  targetId    String?         @map("target_id")
  legacyTable String?         @map("legacy_table") /// 老库对应表名（回补重放用）
  legacyPk    String?         @map("legacy_pk") /// 老库对应主键（回补重放用）
  sqlKind     SqlKind?        @map("sql_kind")
  before      Json?           @db.JsonB
  after       Json?           @db.JsonB
  payload     Json?           @db.JsonB
  ip          String?
  userAgent   String?         @map("user_agent")
  occurredAt  DateTime        @default(now()) @map("occurred_at")

  @@index([targetKind, targetId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_log")

  // —— PG 原生索引（Prisma 可表达部分，随迁移生成；部分唯一索引见 prisma/sql）——
  @@index([after(ops: raw("jsonb_path_ops"))], type: Gin)
  @@index([payload(ops: raw("jsonb_path_ops"))], type: Gin)
}

/// 取代 pte_category（无限级 + lang 分中英）
model ContentCategory {
  id        String      @id @default(uuid(7))
  parentId  String?     @map("parent_id")
  slug      String
  nameCn    String      @map("name_cn")
  nameEn    String?     @map("name_en")
  lang      ContentLang @default(zh)
  isLabel   Boolean     @default(false) @map("is_label") /// islabel
  sortOrder Int         @default(0) @map("sort_order")
  isDeleted Boolean     @default(false) @map("is_deleted")
  createdAt DateTime    @default(now()) @map("created_at")

  parent   ContentCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ContentCategory[] @relation("CategoryTree")
  articles Article[]

  @@unique([lang, slug])
  @@map("content_category")
}

/// 取代 pte_article（列表/SEO）+ pte_article_details（正文，UEditor HTML 净化后入列）
model Article {
  id           String           @id @default(uuid(7))
  categoryId   String?          @map("category_id")
  category     ContentCategory? @relation(fields: [categoryId], references: [id])
  title        String
  summary      String?
  coverKey     String?          @map("cover_key") /// poster → OSS objectKey
  bodyHtml     String?          @map("body_html") /// 净化后的正文（HTML sanitize 在 server 层强制）
  lang         ContentLang      @default(zh)
  sourceLangId String?          @map("source_lang_id") /// 英文稿对应的中文稿（双语工作流）
  sourceLang   Article?         @relation("ArticleLangPair", fields: [sourceLangId], references: [id])
  translations Article[]        @relation("ArticleLangPair")
  isTop        Boolean          @default(false) @map("is_top")
  sortOrder    Int              @default(0) @map("sort_order")
  isOnline     Boolean          @default(true) @map("is_online") /// isonline
  isDeleted    Boolean          @default(false) @map("is_deleted")
  publishedAt  DateTime?        @map("published_at")
  seoTitle     String?          @map("seo_title")
  seoKeywords  String?          @map("seo_keywords")
  legacyRef    String?          @map("legacy_ref") /// 旧 aid/pid（301 映射与 SEO 无损验收用）
  createdBy    String?          @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  translations2 ArticleTranslation[]

  @@index([lang, isOnline, publishedAt])
  @@index([categoryId])
  @@map("article")
}

/// 双语内容工作流（投标版 A 档，§7）：中文定稿 → LLM 初译 → 人工确认发布
model ArticleTranslation {
  id             String            @id @default(uuid(7))
  articleId      String            @map("article_id")
  article        Article           @relation(fields: [articleId], references: [id])
  targetLang     ContentLang       @map("target_lang")
  machineDraft   String?           @map("machine_draft")
  humanReviewed  String?           @map("human_reviewed")
  status         TranslationStatus @default(SOURCE_FINAL)
  llmModel       String?           @map("llm_model")
  terminologyKey String?           @map("terminology_key") /// 术语表版本
  translatedAt   DateTime?         @map("translated_at")
  reviewedBy     String?           @map("reviewed_by")
  reviewedAt     DateTime?         @map("reviewed_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([articleId, targetLang])
  @@map("article_translation")
}

/// 取代 pte_event_info / pte_expo_info（门户登记：eid 硬编码 '2026' 的历史坑改由 showId 承载）
model PortalRegistration {
  id        String   @id @default(uuid(7))
  showId    String?  @map("show_id")
  kind      String /// VISIT / EXPO / CONFERENCE
  name      String?
  company   String?
  job       String?
  contact   String?
  email     String?
  mobile    String?
  nums      String?
  certs     String?
  eventId   String?  @map("event_id") /// pte_event_info.eid 管道串
  legacyRef String?  @map("legacy_ref")
  data      Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([showId, kind])
  @@map("portal_registration")
}

/// 取代 pte_user（旧后台管理员，md5 password/islock）→ 归并入 Member + StaffProfile 之外的历史留档
model LegacyAccount {
  id         String    @id @default(uuid(7))
  source     String /// expo_admin / pte_user / expo_order_login
  externalId String    @map("external_id")
  username   String?
  email      String?
  legacyHash String?   @map("legacy_hash") /// 无盐 MD5 原样保，供兼容校验后重设
  memberId   String?   @map("member_id")
  migratedAt DateTime? @map("migrated_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([source, externalId])
  @@map("legacy_account")
}

/// 文件资产（阶段1 清单化迁移 §8 铁规一：只迁数据库不迁文件=半截迁移）
model MediaAsset {
  id          String    @id @default(uuid(7))
  bucketKind  String    @default("PRIVATE") @map("bucket_kind") /// PRIVATE(媒体/导出件) / STATIC(oss+h5 产物)
  objectKey   String    @unique @map("object_key")
  fileName    String    @map("file_name")
  mime        String?
  sizeBytes   BigInt?   @map("size_bytes")
  width       Int?
  height      Int?
  sha256      String?
  kind        String? /// CONTRACT_SCAN / EXHIBITOR_PHOTO / CAD_DRAWING / EXPORT / FLOOR_PLAN / ARTICLE_IMAGE
  exhibitorId String?   @map("exhibitor_id")
  legacyPath  String?   @map("legacy_path") /// 老服务器 upload/ 相对路径（URL 映射表与 field-mapping 同级管理）
  uploadedBy  String?   @map("uploaded_by")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  deletedAt   DateTime? @map("deleted_at")

  exportJobs ExportJob[]

  @@index([kind])
  @@index([legacyPath])
  @@map("media_asset")
}

/// 取代"TRUNCATE 临时表 + 逐行 echo"流式土办法；PII 导出走签名 URL 15 分钟 + 7 天清理（§9 S10）
model ExportJob {
  id            String          @id @default(uuid(7))
  kind          String /// financial_summary / dues / member_list / directory …
  params        Json?           @db.JsonB
  requesterId   String?         @map("requester_id")
  requester     Member?         @relation(fields: [requesterId], references: [id])
  status        ExportJobStatus @default(QUEUED)
  queueName     String          @default("export") @map("queue_name")
  resultAssetId String?         @map("result_asset_id")
  resultAsset   MediaAsset?     @relation(fields: [resultAssetId], references: [id])
  rowCount      Int?            @map("row_count")
  error         String?
  signedUntil   DateTime?       @map("signed_until")
  purgeAfter    DateTime?       @map("purge_after")
  requestedAt   DateTime        @default(now()) @map("requested_at")
  finishedAt    DateTime?       @map("finished_at")

  @@index([kind, status])
  @@map("export_job")
}

/// 取代各 *_temp 表（TRUNCATE 全表互踩 → 改按任务隔离的导入批次）
model ImportBatch {
  id            String    @id @default(uuid(7))
  kind          String /// EXHIBITOR / ORDER / FINANCIAL / OPT_TYPES / VISITOR
  fileName      String?   @map("file_name")
  sourceAssetId String?   @map("source_asset_id")
  rowCount      Int       @default(0) @map("row_count")
  errorCount    Int       @default(0) @map("error_count")
  status        String    @default("QUEUED")
  queueName     String    @default("import") @map("queue_name")
  params        Json?     @db.JsonB
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  finishedAt    DateTime? @map("finished_at")

  errors ImportBatchError[]

  @@index([kind, status])
  @@map("import_batch")
}

model ImportBatchError {
  id       String      @id @default(uuid(7))
  batchId  String      @map("batch_id")
  batch    ImportBatch @relation(fields: [batchId], references: [id])
  rowNo    Int?        @map("row_no")
  column   String?
  message  String
  rawValue String?     @map("raw_value")

  @@index([batchId])
  @@map("import_batch_error")
}

/// 字典：行政区划 bs_province/bs_city/bs_area（跨系统共用，单独导数据；§11-3 归属待裁决）
model GeoDict {
  id         String  @id @default(uuid(7))
  level      Int /// 1 省 2 市 3 区
  code       String
  parentCode String? @map("parent_code")
  nameCn     String  @map("name_cn")
  nameEn     String? @map("name_en")
  active     Boolean @default(true)

  @@unique([code])
  @@index([parentCode])
  @@map("geo_dict")
}

/// 字典：国家/地区（expo_country）、职务（expo_position）、企业性质/类型等小字典统一收口
model CodeDict {
  id        String  @id @default(uuid(7))
  group     String /// country / position / company_nature / company_type / hall …
  code      String
  labelCn   String  @map("label_cn")
  labelEn   String? @map("label_en")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  @@unique([group, code])
  @@map("code_dict")
}

/// 报表基线快照（§8 第 4 步：迁移前固化现网 financial_total_1~5 + Summary 数字，逐张比对）
model ReportBaseline {
  id        String   @id @default(uuid(7))
  showId    String?  @map("show_id")
  reportKey String   @map("report_key") /// financial_total_1..5 / summary / tj_cdfp / tj_zwxs
  params    Json?    @db.JsonB /// 同参数复算所需入参
  expected  Json     @db.JsonB /// 现网导出数字（甲方签字基线）
  actual    Json?    @db.JsonB /// 新系统复算数字
  diff      Json?    @db.JsonB
  verdict   String   @default("PENDING") /// PENDING/MATCH/WRITE_OFF(书面归因)/SIGNED(甲方签认)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reportKey, showId]) /// 同参数基线一行；多参数场景由 params 承载并走人工签认
  @@map("report_baseline")

  // —— PG 原生索引（Prisma 可表达部分，随迁移生成；部分唯一索引见 prisma/sql）——
  @@index([expected(ops: raw("jsonb_path_ops"))], type: Gin)
  @@index([actual(ops: raw("jsonb_path_ops"))], type: Gin)
  @@index([diff(ops: raw("jsonb_path_ops"))], type: Gin)
}

/// 长尾报表处置签认（投标版：逐张确认"迁移/只读归档"）
model LongTailReport {
  id           String    @id @default(uuid(7))
  reportKey    String    @map("report_key")
  nameCn       String?   @map("name_cn")
  sourceObject String?   @map("source_object") /// 旧视图/SP/PHP 文件
  decision     String    @default("PENDING") /// MIGRATE / ARCHIVE_READONLY / DROP
  signedBy     String?   @map("signed_by")
  signedAt     DateTime? @map("signed_at")
  note         String?

  @@unique([reportKey])
  @@map("long_tail_report")
}
