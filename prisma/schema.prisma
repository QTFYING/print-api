  introEn     String?   @map("intro_en")
  submitted   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("yearbook_info")
}

/// 取代 expo_data_czzj（参展证件）
model Badge {
  id          String    @id @default(uuid(7))
  exhibitorId String    @map("exhibitor_id")
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id])
  personName  String?   @map("person_name") /// RYXM
  title       String? /// ZW
  country     String? /// GB
  idType      String?   @map("id_type") /// ZJLX
  idNo        String?   @map("id_no") /// ZJHM（PII，展示脱敏）
  mobile      String? /// SJH（PII）
  submitted   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([exhibitorId])
  @@map("badge")
}

/// 取代 expo_data_yqh（邀请函申请）
model Invitation {
  id          String    @id @default(uuid(7))
  exhibitorId String    @map("exhibitor_id")
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id])
  quantity    Int       @default(0) /// Num
  remark      String?
  submitted   Boolean   @default(false)
