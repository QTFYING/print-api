// ============================================================
// pte_platform —— 8 域重建模（plans/05 §6，PostgreSQL 16 目标 / 开发库 myserver PG18）
// 原则：
//  1) 不照搬旧表：88 张生效表 → 8 域语义模型；旧列名以 /// 注释保留，供 ETL 映射与对账回查。
//  2) 存疑列不跳过（§6.3 零数据丢失）：legacy_extra JSONB，确认前按内容可检索（GIN 索引见后续迁移）。
//  3) 隐式状态机全部显式化（§6.2）：stage / booth_change_status / receivable_lock / approval_*。
//  4) 届次 scope 强制（§6.3 D3 根治）：业务表 show_id NOT NULL + 复合唯一键 (show_id, booth_no)。
//  5) 金额一律 NUMERIC(12,2)（取代带千分位逗号字符串存库）；币种+汇率快照进财务域（v2.0 补）。
//  6) 只用 PG16/18 通用特性（JSONB/GIN/物化视图），不引入 PG18 独有语法（AGENTS.md 铁律 2 备注）。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举（显式化取代隐式位）====================

/// exhibitors end01~end08 流程位 → 单一状态机（§6.2）
enum ExhibitorStage {
  SUBMITTED // end01 申请表已提交
  APPROVED // end02 申请成功
  BOOTH_ASSIGNED // end03 展位已分配
  BOOTH_CONFIRMED // end04 展位已确定
  CONTRACT_GENERATED // end05 合同已生成
  CONTRACT_SIGNED // end06 合同已签订
  DEPOSIT_PAID // end07 定金支付
  BALANCE_PAID // end08 余款支付
  CANCELLED // iscancel / 作废旁路
}

/// group_leader 1确定/2请求更换/3取消/4审核通过 → 显式枚举
enum BoothChangeRequest {
  CONFIRMED // 1
  REQUEST_CHANGE // 2
  CANCELLED // 3
  APPROVED // 4
}

/// exhibitors016 展台类型
enum BoothType {
  RAW_SPACE // 光地展位
  STANDARD // 标准展位
  ADVERTISEMENT // 广告
}

/// exhibitors_online 在线池(1)/管理池(0)
enum RecordPool {
  ONLINE // 在线注册未确认/被退回
  MANAGED // 已入后台管理池
}

/// exhibitor_stage_log 置位来源（谁改的不再无人知晓）
enum StageChangeSource {
  MANUAL
  CONTRACT_GENERATED // 生成合同 docx ⇒ 自动进 CONTRACT_GENERATED（唯一自动置位点，保留）
  FINANCE_CASCADE // 财务勾选合同已签 ⇒ 级联补置前置阶段（保留）
  CONTRACT_VOID // 删除/作废合同触发回退（旧系统缺陷：不清 end05，新系统修复并记 log）
  MIGRATION // ETL 还原
}

/// 制单单位 ZDRDW_Type / 收款单位 SKDW_Type 1-4（approval_flow_def 16 组合）
