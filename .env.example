# ============================================================
# pte-api 环境变量样例（可提交）；真实凭据只进 .env（gitignore）—— S8 对策
# 本地开发走 SSH 隧道：15433 -> myserver:5432(PG)，16379 -> myserver:6379(Redis)
# 隧道启动：pnpm tunnel
# ============================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Prisma（唯一真相源：本仓 prisma/schema.prisma）
DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:15433/pte_platform_dev?schema=public

# Redis（会话吊销表/限流/验证码/BullMQ 队列 —— 禁止无持久化裸跑，plans/05 §3.1）
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:16379/0

# JWT（短时效 access + refresh 走 httpOnly Cookie，禁 localStorage 落 token）
JWT_ACCESS_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS 白名单（oss/h5 跨源 Bearer；portal 同域 Cookie）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
